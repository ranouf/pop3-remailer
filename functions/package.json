{
  "name": "functions",
  "private": true,
  "main": "lib/index.js",
  "type": "commonjs",
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@10.8.2",
  "scripts": {
    "clean": "rimraf coverage lib",
    "generate:api": "tsoa spec-and-routes",
    "build": "npm run clean && npm run generate:api && tsc -p tsconfig.build.json",
    "typecheck": "npm run generate:api && tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run generate:api && vitest run",
    "coverage": "npm run generate:api && vitest run --coverage"
  },
  "dependencies": {
    "@amplitude/analytics-node": "^1.5.51",
    "@tsoa/runtime": "^6.6.0",
    "@types/express": "^4.17.23",
    "@types/http-errors": "^2.0.5",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "cockatiel": "^3.2.1",
    "dotenv": "^17.2.3",
    "env-var": "^7.5.0",
    "express": "^4.21.2",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^7.2.2",
    "googleapis": "^148.0.0",
    "http-errors": "^2.0.1",
    "http-status-codes": "^2.3.0",
    "inversify": "^6.0.1",
    "node-pop3": "^0.9.1",
    "supertest": "^7.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.30",
    "@vitest/coverage-istanbul": "^4.1.3",
    "@vitest/coverage-v8": "^4.0.8",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.7.4",
    "rimraf": "^6.1.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.3",
    "vitest": "^4.0.8"
  }
}
