{
  "entryFile": "src/index.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": ["src/api/controllers/**/*controller.ts"],
  "spec": {
    "outputDirectory": "src/api/generated",
    "specVersion": 3,
    "specFileBaseName": "swagger",
    "securityDefinitions": {
      "firebaseBearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase ID token"
      }
    }
  },
  "routes": {
    "routesDir": "src/api/generated",
    "middleware": "express",
    "authenticationModule": "src/api/auth/tsoa-authentication.ts",
    "iocModule": "src/api/bootstrap/tsoa-ioc.ts"
  }
}
