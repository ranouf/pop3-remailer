<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationIcon>Assets\remailer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference
      Include="Microsoft.Extensions.Configuration.Binder"
      Version="10.0.6"
    />
    <PackageReference
      Include="Microsoft.Extensions.Configuration.EnvironmentVariables"
      Version="10.0.6"
    />
    <PackageReference
      Include="Microsoft.Extensions.Configuration.Json"
      Version="10.0.6"
    />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Assets\*.ico" />
    <ProjectReference Include="..\IMAPRemailer.Core\IMAPRemailer.Core.csproj" />
    <ProjectReference Include="..\IMAPRemailer.Infrastructure\IMAPRemailer.Infrastructure.csproj" />
  </ItemGroup>
</Project>
